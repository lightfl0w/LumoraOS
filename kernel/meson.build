kernel_elf = executable('kernel.elf',
  'arch/x86_64/boot.S',
  'arch/x86_64/gdt.c',
  'arch/x86_64/idt.c',
  'arch/x86_64/isr.S',
  'arch/x86_64/lapic.c',
  'arch/x86_64/pic.c',
  'core/main.c',
  'drivers/pit.c',
  'drivers/serial.c',
  'mm/paging.c',
  c_args: common_cflags + [
    '-mno-sse',
    '-mno-sse2',
  ],
  link_args: common_cflags + [
    '-nostdlib',
    '-static',
    '-Wl,-T,' + meson.current_source_dir() / 'arch/x86_64/linker.ld',
    '-Wl,--build-id=none',
    '-Wl,-z,max-page-size=4096',
  ],
)
