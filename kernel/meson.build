kernel_elf = executable('kernel.elf',
  'arch/x86_64/boot.S',
  'arch/x86_64/gdt.c',
  'arch/x86_64/idt.c',
  'arch/x86_64/isr.S',
  'arch/x86_64/lapic.c',
  'arch/x86_64/pic.c',
  'arch/x86_64/switch.S',
  'core/main.c',
  'drivers/console.c',
  'drivers/keyboard.c',
  'drivers/pit.c',
  'drivers/serial.c',
  'mm/kmalloc.c',
  'mm/page_alloc.c',
  'mm/paging.c',
  'sched/thread.c',
  c_args: common_cflags + [
    '-mno-sse',
    '-mno-sse2',
  ],
  link_depends: files('../buildsys/x86_64.ld'),
  link_args: common_cflags + [
    '-nostdlib',
    '-static',
    '-Wl,-T,' + meson.project_source_root() / 'buildsys/x86_64.ld',
    '-Wl,--build-id=none',
    '-Wl,-z,max-page-size=4096',
  ],
)
